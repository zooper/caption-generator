# AI Caption Studio — self-hosted environment.
# Copy to .env on the target host (root-owned, chmod 600). NEVER commit .env.
# server-node.js refuses to start without JWT_SECRET.

# --- Required ---
JWT_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=sk-proj-...

# --- Public origin (WebAuthn + magic-link URLs) ---
# Must be the exact https origin users hit. RP_ID is the hostname only.
# Passkeys are bound to RP_ID — changing it invalidates existing passkeys.
PUBLIC_ORIGIN=https://captions.example.com
RP_ID=captions.example.com

# --- Email (Resend HTTP API) ---
SMTP_PASSWORD=re_...                       # Resend API key
SMTP_FROM_EMAIL=no-reply@jonsson.io
SMTP_FROM_NAME=AI Caption Studio

# --- Admin / misc ---
ADMIN_EMAIL=tomas@jonsson.io               # this email becomes admin on signup
OPENWEATHER_API_KEY=                        # optional, weather context
INSTAGRAM_APP_SECRET=                       # optional, Instagram posting
GIT_COMMIT=                                 # optional, shown as build version

# --- Runtime paths (defaults shown; data/ persists across deploys) ---
PORT=3000
DATA_DIR=/opt/caption-studio/data
# DB_PATH=/opt/caption-studio/data/caption-studio.sqlite
# IMAGES_DIR=/opt/caption-studio/data/images
